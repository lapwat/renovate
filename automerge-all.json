{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "abandonments:recommended",
        "group:all",
        ":automergeAll",
        ":automergeBranch",
        ":skipStatusChecks",
        ":pinVersions"
    ],
    "lockFileMaintenance": {
        "enabled": true,
	"automerge": true,
        "schedule": ["at any time"]
    },
    "dependencyDashboardOSVVulnerabilitySummary": "all",
    "osvVulnerabilityAlerts": true,
    "vulnerabilityAlerts": {
        "enabled": true
    }
}
