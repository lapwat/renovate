{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "abandonments:recommended",
        "group:allNonMajor",
        ":approveMajorUpdates",
        ":automergeAll",
        ":automergeBranch",
        ":skipStatusChecks",
        ":pinVersions"
    ],
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": ["at any time"]
    },
    "dependencyDashboardOSVVulnerabilitySummary": "all",
    "osvVulnerabilityAlerts": true,
    "vulnerabilityAlerts": {
        "enabled": true
    },
    "customManagers": [
        {
            "customType": "regex",
            "datasourceTemplate": "docker",
            "depNameTemplate": "ghcr.io/{{{depName}}}",
            "fileMatch": ["\\.ya?ml$"],
            "matchStrings": [
                "^[ \\t]*#[ \\t]*renovate:[ \\t]*repo=(?<depName>[^\\s]+)[ \\t]*\\r?\\n[ \\t]*[\\w\\-]+:[ \\t]*\\'?(?<currentValue>[^\\'\"\\s]+)\\'?"
            ]
        }
    ]
}
